                },
                "plotType": "LINE",
                "legendTemplate": "${metric.labels.cluster} Total: ${metric.labels.node}"
              }
            ],
            "yAxis": {
              "label": "MB"
            }
          }
        }
      },
      {
        "yPos": 38,
        "width": 24,
        "height": 8,
        "widget": {
          "title": "GPU Utilization % (by cluster)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (cluster) (slurm_node_gpu_alloc) / sum by (cluster) (slurm_node_gpu_total) * 100"
                },
                "plotType": "LINE",
                "legendTemplate": "${metric.labels.cluster}"
              }
            ],
            "yAxis": {
              "label": "%"
            }
          }
        }
      },
      {
        "xPos": 24,
        "yPos": 38,
        "width": 24,
        "height": 8,
        "widget": {
          "title": "CPU Utilization % (by cluster)",
