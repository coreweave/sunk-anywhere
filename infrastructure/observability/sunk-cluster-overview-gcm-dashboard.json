                "plotType": "STACKED_AREA",
                "legendTemplate": "Completed"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_queue_failed"
                },
                "plotType": "STACKED_AREA",
                "legendTemplate": "Failed"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_queue_canceled"
                },
                "plotType": "STACKED_AREA",
                "legendTemplate": "Canceled"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_queue_suspended"
                },
                "plotType": "STACKED_AREA",
                "legendTemplate": "Suspended"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_queue_timeout"
                },
                "plotType": "STACKED_AREA",
                "legendTemplate": "Timeout"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_queue_node_fail"
                },
                "plotType": "STACKED_AREA",
                "legendTemplate": "Node Fail"
              }
            ],
            "yAxis": {
              "label": "jobs"
            }
          }
        }
      },
      {
        "yPos": 60,
        "width": 48,
        "height": 12,
        "widget": {
          "title": "Slurm Jobs (all clusters)",
          "timeSeriesTable": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_job_state"
                },
                "minAlignmentPeriod": "60s"
              }
            ],
            "columnSettings": [
              {
                "column": "cluster",
                "visible": true
              },
              {
                "column": "id",
                "visible": true
              },
              {
                "column": "name",
                "visible": true
              },
              {
                "column": "user",
                "visible": true
              },
              {
                "column": "account",
                "visible": true
              },
              {
                "column": "partition",
                "visible": true
              },
              {
                "column": "state",
                "visible": true
              },
              {
                "column": "value",
                "visible": true
              }
            ]
          }
        }
      },
