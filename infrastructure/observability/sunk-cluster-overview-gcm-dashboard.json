{
  "displayName": "SUNK: Slurm Cluster Overview",
  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "width": 48,
        "height": 2,
        "widget": {
          "title": "",
          "text": {
            "content": "## Fleet Summary",
            "format": "MARKDOWN"
          }
        }
      },
      {
        "yPos": 2,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Total Nodes",
          "scorecard": {
            "timeSeriesQuery": {
              "prometheusQuery": "slurm_nodes_total"
            }
          }
        }
      },
      {
        "xPos": 6,
