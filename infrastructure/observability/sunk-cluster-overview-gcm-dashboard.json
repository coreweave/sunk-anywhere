      {
        "xPos": 36,
        "yPos": 2,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Completing",
          "scorecard": {
            "timeSeriesQuery": {
              "prometheusQuery": "slurm_nodes_comp"
