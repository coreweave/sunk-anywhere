          "title": "Not Responding",
          "scorecard": {
            "timeSeriesQuery": {
              "prometheusQuery": "slurm_nodes_not_responding"
            }
          }
        }
      },
      {
        "yPos": 6,
        "width": 24,
        "height": 8,
        "widget": {
          "title": "Node States Over Time (by cluster)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_nodes_alloc"
                },
                "plotType": "STACKED_AREA",
                "legendTemplate": "${metric.labels.cluster} Allocated"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_nodes_mix"
                },
                "plotType": "STACKED_AREA",
                "legendTemplate": "${metric.labels.cluster} Mixed"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_nodes_idle"
                },
                "plotType": "STACKED_AREA",
                "legendTemplate": "${metric.labels.cluster} Idle"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_nodes_drain"
                },
                "plotType": "STACKED_AREA",
                "legendTemplate": "${metric.labels.cluster} Drained"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_nodes_down"
                },
                "plotType": "STACKED_AREA",
                "legendTemplate": "${metric.labels.cluster} Down"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_nodes_comp"
                },
                "plotType": "STACKED_AREA",
                "legendTemplate": "${metric.labels.cluster} Completing"
              }
            ],
            "yAxis": {
              "label": "nodes"
            }
          }
        }
      },
      {
        "xPos": 24,
        "yPos": 6,
        "width": 24,
        "height": 8,
        "widget": {
          "title": "Per-Node State (by cluster)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_node_state"
                },
                "plotType": "LINE",
                "legendTemplate": "${metric.labels.cluster}/${metric.labels.node}: ${metric.labels.state}"
              }
            ],
            "yAxis": {
              "label": "state"
            }
          }
        }
      },
      {
        "yPos": 14,
        "width": 48,
        "height": 2,
        "widget": {
          "title": "",
          "text": {
            "content": "## Partition Resources",
            "format": "MARKDOWN"
          }
        }
      },
      {
        "yPos": 16,
        "width": 16,
        "height": 8,
        "widget": {
          "title": "Partition GPU Allocation",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_partition_gpu_alloc"
                },
                "plotType": "STACKED_BAR",
                "legendTemplate": "${metric.labels.cluster} Alloc: ${metric.labels.partition}"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_partition_gpu_idle"
                },
                "plotType": "STACKED_BAR",
                "legendTemplate": "${metric.labels.cluster} Idle: ${metric.labels.partition}"
              }
            ],
            "yAxis": {
              "label": "GPUs"
            }
          }
        }
      },
      {
        "xPos": 16,
        "yPos": 16,
        "width": 16,
        "height": 8,
        "widget": {
          "title": "Partition CPU Allocation",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_partition_cpu_alloc"
                },
                "plotType": "STACKED_BAR",
                "legendTemplate": "${metric.labels.cluster} Alloc: ${metric.labels.partition}"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_partition_cpu_idle"
                },
                "plotType": "STACKED_BAR",
                "legendTemplate": "${metric.labels.cluster} Idle: ${metric.labels.partition}"
              }
            ],
            "yAxis": {
              "label": "CPUs"
            }
          }
        }
      },
      {
        "xPos": 32,
        "yPos": 16,
        "width": 16,
        "height": 8,
        "widget": {
          "title": "Partition Memory Allocation (MB)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_partition_mem_alloc"
                },
                "plotType": "STACKED_BAR",
                "legendTemplate": "Alloc: ${metric.labels.partition}"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_partition_mem_total - slurm_partition_mem_alloc"
                },
                "plotType": "STACKED_BAR",
                "legendTemplate": "Free: ${metric.labels.partition}"
              }
            ],
            "yAxis": {
              "label": "MB"
            }
          }
        }
      },
      {
        "yPos": 24,
        "width": 12,
        "height": 4,
        "widget": {
          "title": "Total GPUs",
          "scorecard": {
            "timeSeriesQuery": {
              "prometheusQuery": "sum(slurm_partition_gpu_total)"
            }
          }
        }
      },
      {
        "xPos": 12,
        "yPos": 24,
        "width": 12,
        "height": 4,
        "widget": {
          "title": "GPUs Allocated",
          "scorecard": {
            "timeSeriesQuery": {
              "prometheusQuery": "sum(slurm_partition_gpu_alloc)"
            }
          }
        }
      },
      {
        "xPos": 24,
        "yPos": 24,
        "width": 12,
        "height": 4,
        "widget": {
          "title": "Total CPUs",
          "scorecard": {
            "timeSeriesQuery": {
              "prometheusQuery": "sum(slurm_partition_cpu_total)"
            }
          }
        }
      },
      {
        "xPos": 36,
        "yPos": 24,
        "width": 12,
        "height": 4,
        "widget": {
          "title": "CPUs Allocated",
          "scorecard": {
            "timeSeriesQuery": {
              "prometheusQuery": "sum(slurm_partition_cpu_alloc)"
            }
          }
        }
