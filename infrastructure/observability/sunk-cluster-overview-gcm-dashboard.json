        "yPos": 52,
        "width": 16,
        "height": 8,
        "widget": {
          "title": "Running vs Pending (by cluster)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_queue_running"
                },
                "plotType": "LINE",
                "legendTemplate": "${metric.labels.cluster} Running"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_queue_pending"
                },
                "plotType": "LINE",
                "legendTemplate": "${metric.labels.cluster} Pending"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "slurm_queue_pending_dependency"
                },
                "plotType": "LINE",
                "legendTemplate": "${metric.labels.cluster} Pending (dep)"
              }
            ],
            "yAxis": {
              "label": "jobs"
            }
          }
        }
      },
      {
        "xPos": 16,
        "yPos": 52,
        "width": 16,
        "height": 8,
        "widget": {
          "title": "Job Throughput (jobs/sec)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "rate(slurm_scheduler_jobs_completed[5m])"
                },
                "plotType": "LINE",
                "legendTemplate": "Completed"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "rate(slurm_scheduler_jobs_failed[5m])"
                },
                "plotType": "LINE",
                "legendTemplate": "Failed"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "rate(slurm_scheduler_jobs_submitted[5m])"
                },
                "plotType": "LINE",
                "legendTemplate": "Submitted"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "rate(slurm_scheduler_jobs_started[5m])"
                },
                "plotType": "LINE",
                "legendTemplate": "Started"
              },
              {
                "timeSeriesQuery": {
                  "prometheusQuery": "rate(slurm_scheduler_jobs_cancelled[5m])"
                },
                "plotType": "LINE",
                "legendTemplate": "Cancelled"
              }
            ],
            "yAxis": {
              "label": "jobs/sec"
            }
          }
        }
      },
