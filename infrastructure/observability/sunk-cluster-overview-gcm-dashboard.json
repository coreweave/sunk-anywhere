      {
        "xPos": 30,
        "yPos": 2,
        "width": 6,
        "height": 4,
        "widget": {
          "title": "Down",
          "scorecard": {
            "timeSeriesQuery": {
              "prometheusQuery": "slurm_nodes_down"
