      "properties": {
        "markdown": "# SUNK on EKS \u2014 Cluster Overview\n\nNode + pod metrics from CloudWatch Container Insights (`ContainerInsights` namespace) and GPU metrics from the addon-bundled DCGM exporter (`ContainerInsights/Prometheus`). Pair with `sunk-eks-jobs-cloudwatch` for Slurm-job throughput. Region/cluster substituted at install time by `infrastructure/eks/install-cw-dashboards.sh`."
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 2,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Cluster CPU Utilization (%)",
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-2",
        "period": 60,
        "stat": "Average",
        "metrics": [
          [
            "ContainerInsights",
            "node_cpu_utilization",
            "ClusterName",
            "__CLUSTER_NAME__"
          ]
        ],
        "yAxis": {
